{
  "name": "talkcrm-desktop",
  "productName": "TalkCRM Desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm:desktop:launch\"",
    "desktop:launch": "wait-on http://127.0.0.1:5173 && npm run build:electron && node scripts/launchDesktop.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node22 --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:sql.js",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "desktop:build": "npm run build && node scripts/buildDesktop.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "demo:export": "esbuild scripts/exportDemo.ts --bundle --platform=node --format=cjs --outfile=.tmp/export-demo.cjs --external:sql.js && node .tmp/export-demo.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.9.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ru.talkcrm.desktop",
    "productName": "TalkCRM Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-web/**/*",
      "dist-electron/**/*",
      "migrations/**/*",
      "package.json",
      "node_modules/sql.js/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TalkCRM Setup.exe"
    }
  }
}
